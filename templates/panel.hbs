<div class="iv-app">
  <aside class="iv-sidebar">
    <header class="iv-brand"><span class="iv-eyebrow">Sangue Escuro</span><h2>Pistas e<br>Investigações</h2><p>Registros, conexões e perguntas em aberto.</p></header>
    {{#if gm}}<button type="button" class="iv-primary" data-action="investigacao" data-op="newCase">Nova investigação</button>{{/if}}
    <nav class="iv-cases" aria-label="Investigações">{{#each cases}}<button type="button" data-action="investigacao" data-op="case" data-id="{{id}}" class="iv-case {{#if selected}}iv-active{{/if}}" {{#if selected}}aria-current="page"{{/if}}><strong>{{name}}</strong><small>{{statusName}}{{#if pending}} · {{pending}} proposta(s) pendente(s){{/if}}</small></button>{{else}}<p class="iv-muted">{{#if gm}}Crie o primeiro caso. Ele começa reservado ao Mestre.{{else}}Nenhuma investigação foi compartilhada com você.{{/if}}</p>{{/each}}</nav>
    <footer class="iv-sidebar-footer"><button type="button" data-action="investigacao" data-op="sync">Sincronizar</button><small>{{#if connected}}Mestre conectado{{else}}Sem Mestre conectado: consulta disponível{{/if}}</small></footer>
  </aside>
  <main class="iv-main">
  {{#if current}}
    <header class="iv-case-header"><div><span class="iv-eyebrow">{{current.statusName}}{{#if gm}} · {{current.audienceName}}{{/if}}</span><h2>{{current.name}}</h2><p class="iv-pre">{{current.intro}}</p></div><div class="iv-case-actions">{{#if gm}}<button type="button" data-action="investigacao" data-op="editCase">Editar caso</button><button type="button" data-action="investigacao" data-op="shareCase">Revelar / ocultar caso</button><button type="button" class="iv-danger" data-action="investigacao" data-op="deleteCase">Excluir caso</button>{{/if}}<button type="button" data-action="investigacao" data-op="note" {{#unless connected}}disabled{{/unless}}>Minhas anotações</button></div></header>
    {{#if pending}}<p class="iv-warning" role="status">Os dados estão salvos, mas há visões pendentes de sincronização. Use Sincronizar.</p>{{/if}}
    {{#if current.hidden}}<p class="iv-warning">Caso reservado ao Mestre. Revele o caso e escolha quais pistas cada jogador poderá ver.</p>{{/if}}
    <div class="iv-toolbar"><div class="iv-switch" aria-label="Visualização"><button type="button" data-action="investigacao" data-op="board" aria-pressed="{{boardMode}}">Quadro</button><button type="button" data-action="investigacao" data-op="list" aria-pressed="{{listMode}}">Lista</button></div><label class="iv-search"><span class="iv-sr-only">Buscar pistas</span><input type="search" data-iv-search value="{{query}}" placeholder="Buscar título, descrição ou etiqueta"></label><label><span class="iv-sr-only">Tipo de pista</span><select data-iv-type><option value="">Todos os tipos</option>{{#each types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><span class="iv-count">{{current.clueCount}} pistas · {{current.linkCount}} conexões</span></div>
    <div class="iv-actions">{{#if gm}}<button type="button" class="iv-primary" data-action="investigacao" data-op="newClue">Adicionar pista</button>{{#if canConnect}}<button type="button" data-action="investigacao" data-op="newLink">Conectar pistas</button>{{/if}}{{else}}{{#if allowTheories}}{{#if canConnect}}<button type="button" data-action="investigacao" data-op="newLink" {{#unless connected}}disabled{{/unless}}>Propor conexão</button>{{/if}}{{/if}}{{/if}}
    {{#if boardMode}}{{#if hasCards}}<div class="iv-zoom"><button type="button" data-action="investigacao" data-op="zoomOut" aria-label="Reduzir zoom">−</button><span>{{zoom}}%</span><button type="button" data-action="investigacao" data-op="zoomIn" aria-label="Ampliar zoom">+</button><button type="button" data-action="investigacao" data-op="fit">Enquadrar</button><button type="button" data-action="investigacao" data-op="resetZoom">100%</button>{{#unless gm}}<button type="button" data-action="investigacao" data-op="resetLayout">Usar disposição do Mestre</button>{{/unless}}</div>{{/if}}{{/if}}</div>
    <div class="iv-workspace {{#if hasSelection}}iv-with-inspector{{/if}}">
      {{#if hasCards}}
      {{#if boardMode}}<div class="iv-viewport" aria-label="Quadro de pistas. Arraste o fundo para navegar e use a lista para acesso por teclado."><div class="iv-extent" style="width:{{scaledWidth}}px;height:{{scaledHeight}}px"><div class="iv-canvas" style="width:{{width}}px;height:{{height}}px;transform:scale({{scale}})"><svg class="iv-connections" width="{{width}}" height="{{height}}" aria-label="Conexões">{{#each links}}<g data-action="investigacao" data-op="selectLink" data-id="{{id}}" data-link="{{id}}" data-from="{{from}}" data-to="{{to}}" class="iv-edge {{#if hypothesis}}iv-hypothesis{{/if}} {{#if selected}}iv-selected-edge{{/if}}"><title>{{label}}</title><line x1="{{x1}}" y1="{{y1}}" x2="{{x2}}" y2="{{y2}}"></line><text x="{{mx}}" y="{{my}}" text-anchor="middle">{{label}}</text></g>{{/each}}</svg>
      {{#each cards}}<button type="button" class="iv-clue {{#if selected}}iv-selected{{/if}} {{#if hidden}}iv-hidden{{/if}}" style="left:{{x}}px;top:{{y}}px" data-action="investigacao" data-op="selectClue" data-id="{{id}}" data-clue="{{id}}"><span class="iv-card-type">{{typeName}}{{#if hidden}} · Oculta{{/if}}</span><img src="{{image}}" alt="" draggable="false"><strong>{{name}}</strong><small>{{analysisName}}</small></button>{{/each}}
      </div></div></div>{{else}}<div class="iv-list">{{#each cards}}<button type="button" class="iv-list-clue {{#if selected}}iv-selected{{/if}}" data-action="investigacao" data-op="selectClue" data-id="{{id}}"><img src="{{image}}" alt=""><span><small>{{typeName}}{{#if hidden}} · Oculta{{/if}}</small><strong>{{name}}</strong><small>{{analysisName}}{{#each tags}} · {{this}}{{/each}}</small></span></button>{{/each}}</div>{{/if}}
      {{else}}<div class="iv-empty"><img src="modules/sangue-escuro-investigacoes/assets/icones/evidencia.svg" alt=""><h3>{{#if hasClues}}Nenhuma pista corresponde ao filtro{{else}}O caso começa com uma pergunta{{/if}}</h3><p>{{#if gm}}{{#if hasClues}}Altere a busca ou o tipo de pista.{{else}}Adicione a primeira evidência, fotografia ou depoimento. Também é possível arrastar um documento do Foundry para este espaço.{{/if}}{{else}}As pistas reveladas pelo Mestre aparecerão aqui.{{/if}}</p></div>{{/if}}
      {{#if hasSelection}}<aside class="iv-inspector"><button type="button" class="iv-close-inspector" data-action="investigacao" data-op="closeInspector">Fechar detalhes</button>
        {{#if selected}}<span class="iv-eyebrow">{{selected.typeName}}</span><h3>{{selected.name}}</h3><img class="iv-detail-image" src="{{selected.image}}" alt="Imagem da pista"><p class="iv-pre">{{selected.text}}</p><p class="iv-muted">{{selected.analysisName}}</p><div class="iv-tags">{{#each selected.tags}}<span>{{this}}</span>{{/each}}</div>
        {{#if gm}}<p class="iv-muted">Visibilidade: {{selected.audienceName}}</p><div class="iv-buttons"><button type="button" data-action="investigacao" data-op="editClue">Editar</button><button type="button" data-action="investigacao" data-op="shareClue">Revelar / ocultar</button><button type="button" class="iv-danger" data-action="investigacao" data-op="deleteClue">Excluir pista</button>{{#if selected.sourceUuid}}<button type="button" data-action="investigacao" data-op="source">Abrir origem</button>{{/if}}</div>{{#if selected.private}}<section class="iv-secret"><h4>Reservado ao Mestre</h4><p class="iv-pre">{{selected.private}}</p></section>{{/if}}{{/if}}
        <h4>Conexões</h4>{{#each selected.connections}}<button type="button" class="iv-connection-item" data-action="investigacao" data-op="selectLink" data-id="{{id}}"><small>{{kindName}}</small><strong>{{label}}</strong><span>{{other}}</span></button>{{else}}<p class="iv-muted">Nenhuma conexão disponível.</p>{{/each}}{{/if}}
        {{#if selectedLink}}<span class="iv-eyebrow">{{selectedLink.kindName}}</span><h3>{{selectedLink.label}}</h3><p>{{selectedLink.fromName}} ↔ {{selectedLink.toName}}</p>{{#if gm}}<p class="iv-muted">Visibilidade: {{selectedLink.audienceName}}</p><div class="iv-buttons"><button type="button" data-action="investigacao" data-op="editLink">Editar conexão</button><button type="button" data-action="investigacao" data-op="shareLink">Revelar / ocultar</button><button type="button" class="iv-danger" data-action="investigacao" data-op="deleteLink">Excluir conexão</button></div>{{#if selectedLink.private}}<section class="iv-secret"><h4>Reservado ao Mestre</h4><p class="iv-pre">{{selectedLink.private}}</p></section>{{/if}}{{/if}}{{/if}}
      </aside>{{/if}}
    </div>
    <footer class="iv-case-footer"><p>{{#if gm}}Arraste as pistas para organizar o quadro compartilhado.{{else}}Mover pistas reorganiza somente a sua visão, neste navegador.{{/if}} Arraste o fundo para navegar.</p></footer>
    <details class="iv-bottom"><summary>{{#if gm}}Propostas dos jogadores{{else}}Minhas propostas{{/if}}{{#if hasTheories}} · {{theories.length}}{{/if}}</summary>{{#each theories}}<article class="iv-theory"><div><strong>{{label}}</strong><small>{{status}}{{#if authorName}} · {{authorName}}{{/if}}</small><p>{{fromName}} ↔ {{toName}}</p><p class="iv-pre">{{text}}</p>{{#if feedback}}<p class="iv-pre"><strong>Resposta:</strong> {{feedback}}</p>{{/if}}</div>{{#if pending}}<div>{{#if ../gm}}<button type="button" data-action="investigacao" data-op="resolve" data-id="{{id}}">Conferir</button>{{else}}<button type="button" data-action="investigacao" data-op="deleteTheory" data-id="{{id}}">Retirar proposta</button>{{/if}}</div>{{/if}}{{#if ../gm}}<button type="button" data-action="investigacao" data-op="deleteTheory" data-id="{{id}}">Excluir proposta</button>{{/if}}</article>{{else}}<p class="iv-muted">{{#if gm}}As propostas ficam reservadas ao autor e ao Mestre até a aprovação.{{else}}Escolha duas pistas disponíveis para propor uma conexão ao Mestre.{{/if}}</p>{{/each}}</details>
    {{#if note}}<details class="iv-bottom"><summary>Minhas anotações</summary><p class="iv-muted">Visíveis para você e o Mestre.</p><p class="iv-pre">{{note}}</p></details>{{/if}}
    {{#if gm}}{{#if hasPlayerNotes}}<details class="iv-bottom iv-secret"><summary>Anotações dos participantes — reservado ao Mestre</summary>{{#each playerNotes}}<article class="iv-theory"><div><strong>{{name}}</strong><p class="iv-pre">{{text}}</p></div></article>{{/each}}</details>{{/if}}{{/if}}
    {{#if gm}}{{#if current.private}}<details class="iv-bottom iv-secret"><summary>Arquivo reservado do caso</summary><p class="iv-pre">{{current.private}}</p></details>{{/if}}{{/if}}
  {{else}}
    <div class="iv-welcome"><span class="iv-eyebrow">Uma história em fragmentos</span><h2>O que as pistas têm em comum?</h2><p>{{#if gm}}Crie uma investigação, reúna evidências e revele ao grupo apenas o que seus personagens descobriram.{{else}}Quando o Mestre compartilhar uma investigação, você poderá consultar as pistas, organizar sua visão e propor conexões.{{/if}}</p>{{#if gm}}<button type="button" class="iv-primary" data-action="investigacao" data-op="newCase">Criar primeira investigação</button>{{/if}}</div>
  {{/if}}
  </main>
</div>
